# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit actual keys.

# Supabase — Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AWS S3 — from your Terraform outputs
# Credentials are resolved via the AWS SDK default credential provider
# chain — never set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here.
AWS_REGION=
AWS_S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=

# Local development only — name of an AWS named profile (configured via
# `aws configure --profile nexora-app`) that the default credential
# provider chain will pick up. Not used/needed on EC2, which authenticates
# via its IAM Role / Instance Profile instead.
AWS_PROFILE=

# Google Gemini — server-side only (lib/ai/). Never expose this as
# NEXT_PUBLIC_GEMINI_API_KEY; it must never reach the browser.
GEMINI_API_KEY=

# Upstash Redis — server-side only (lib/ai/memory.ts): temporary AI assistant
# conversation memory. Runtime secrets: never NEXT_PUBLIC_*, never baked into
# a build/image. Optional — if unset, the assistant runs without memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Payments — server-side only (lib/payments/). None of these may ever be
# NEXT_PUBLIC_*, logged, or baked into a build/image.
# ---------------------------------------------------------------------------
# Provider used for NEW checkouts. Currently only "safepay". Store currency is
# fixed to USD in code, not configured here.
PAYMENT_PROVIDER=safepay

# Absolute public origin of this deployment, no trailing slash — used to build
# the payment return/cancel URLs (never derived from the request Host header).
# Local development: your HTTPS tunnel URL. EC2: the public HTTPS site URL.
# e.g. https://nexora.example.com
APP_BASE_URL=

# Supabase secret key (sb_secret_...) — Project Settings > API Keys > Secret
# keys. Must belong to the SAME project as NEXT_PUBLIC_SUPABASE_URL above.
# Used only to record verified payments from webhooks, which arrive without a
# user session. Bypasses Row Level Security: never expose it to a browser.
# Do not use the legacy service_role JWT key.
SUPABASE_SECRET_KEY=

# Safepay — sandbox only for now; live payments are not enabled.
# Sandbox dashboard (separate sign-up from live):
#   https://sandbox.api.getsafepay.com/dashboard/login
SAFEPAY_ENVIRONMENT=sandbox
# Developers > API: "Public API Key" (starts with sec_). Identifies the
# merchant account; still kept server-side.
SAFEPAY_API_KEY=
# Developers > API: "Private API Secret Key".
SAFEPAY_SECRET_KEY=
# Developers > Endpoints > (your webhook endpoint) > View shared secret.
SAFEPAY_WEBHOOK_SECRET=

# Payment reconciliation (expired checkouts + recorded webhook events) —
# server-only secret for the internal endpoint
# POST /api/internal/payments/reconcile (Authorization: Bearer <secret>).
# At least 32 random characters; leave empty to disable the endpoint.
# Called by a scheduler on the server host, never by browsers.
PAYMENT_RECONCILE_SECRET=
